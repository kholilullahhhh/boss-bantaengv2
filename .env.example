# ==============================================================================
# BOSS — Bantaeng Office Smart System — Environment Variables
# ==============================================================================
# Copy this file to `.env` and fill in the values.
# Never commit `.env` or `.env.local` to version control.

# --- Database -----------------------------------------------------------------
# Runtime connection string (Neon pooled / pooler connection recommended).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?schema=public&sslmode=require"
# Direct connection string used by Prisma for migrations (Neon direct endpoint).
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?schema=public&sslmode=require"

# --- Authentication -----------------------------------------------------------
# Generate with: npx auth secret
# Used to sign JWT session cookies. Required in production.
AUTH_SECRET="replace-with-a-long-random-secret"
# Set to "true" when running behind a proxy (Vercel sets this automatically).
AUTH_TRUST_HOST="true"

# --- File storage -------------------------------------------------------------
# Choose ONE provider:
#   1) Vercel Blob (recommended for production on Vercel)
#      BLOB_READ_WRITE_TOKEN is created automatically when you enable Blob
#      storage in the Vercel dashboard.
#   2) Local filesystem (default when no blob token is set — for development)
#      Files are stored in ./storage and served through an authenticated route.
STORAGE_DRIVER="auto"
BLOB_READ_WRITE_TOKEN=""

# --- Application --------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="BOSS — Bantaeng Office Smart System"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Seed ---------------------------------------------------------------------
# Development-only password given to every seeded account.
SEED_DEFAULT_PASSWORD="BossBantaeng2025!"

# --- Optional: login rate limiting (Upstash Redis) ----------------------------
# When unset, an in-memory limiter is used (development fallback).
# Production is strongly advised to set these.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
